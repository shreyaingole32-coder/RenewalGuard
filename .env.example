# ============================================================
# RenewalGuard — environment configuration (example)
# Copy to .env and fill in real values. Never commit the real .env.
# ============================================================

# ---------- General ----------
NODE_ENV=development
ENVIRONMENT=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api
AGENTS_BASE_URL=http://localhost:8001

# ---------- PostgreSQL (apps/api system of record) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=renewalguard
POSTGRES_USER=renewalguard
POSTGRES_PASSWORD=change-me-locally
POSTGRES_URL=jdbc:postgresql://localhost:5432/renewalguard

# ---------- Redis (cache + job queue) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Object storage (contract PDFs, MinIO locally / S3 in prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renewalguard-contracts
S3_ACCESS_KEY=renewalguard
S3_SECRET_KEY=change-me-locally
S3_FORCE_PATH_STYLE=true

# ---------- Auth (apps/api) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
# SSO / SAML / OIDC — enterprise tenants
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---------- apps/agents (FastAPI) ----------
AGENTS_SERVICE_SECRET=change-me-shared-secret-between-api-and-agents
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
OCR_PROVIDER=tesseract
# Optional external pricing benchmark data providers
VENDR_API_KEY=
G2_API_KEY=

# ---------- Outbound email (negotiation / cancellation drafts) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=procurement@renewalguard.ai
# Mailhog is used locally to catch outbound mail without sending it — see docker-compose.yml

# ---------- Web (Next.js, public runtime vars) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=RenewalGuard
NEXT_PUBLIC_ENV=development

# ---------- Observability ----------
SENTRY_DSN=
LOG_LEVEL=info

# ---------- Feature flags ----------
FEATURE_AUTO_DRAFT_NEGOTIATION_EMAILS=true
FEATURE_REQUIRE_APPROVAL_FOR_SEND=true
